{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample server for Bidkan Clean Architecture.",
        "title": "Bidkan Backend API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/v1/bikes": {
            "get": {
                "description": "Get a list of all bikes in the system.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bikes"
                ],
                "summary": "List All Bikes (Admin)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/entity.BikeData"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Add a new bike to the system.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bikes"
                ],
                "summary": "Create New Bike (Admin)",
                "parameters": [
                    {
                        "description": "Bike creation request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_app_usecase_bike_create.Request"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/bikes/available": {
            "get": {
                "description": "Get a list of bikes that are available for rent.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bikes"
                ],
                "summary": "List Available Bikes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/entity.BikeData"
                            }
                        }
                    }
                }
            }
        },
        "/v1/rides/end": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Stop the current ride and calculate fare.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rides"
                ],
                "summary": "End Ride (Return Bike)",
                "parameters": [
                    {
                        "description": "End ride request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/end.Request"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/entity.Ride"
                        }
                    }
                }
            }
        },
        "/v1/rides/start": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Start a new ride by scanning a bike QR code.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rides"
                ],
                "summary": "Start Ride (Rent Bike)",
                "parameters": [
                    {
                        "description": "Start ride request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/start.Request"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/entity.Ride"
                        }
                    }
                }
            }
        },
        "/v1/users": {
            "post": {
                "description": "Register a new user with phone number, username, and password. After success, an OTP will be sent.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Create a new user (and send OTP)",
                "parameters": [
                    {
                        "description": "User creation request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_app_usecase_user_create.Request"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User created pending, OTP sent",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request or validation failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/users/login": {
            "post": {
                "description": "Login with username and password to receive a JWT token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Login User",
                "parameters": [
                    {
                        "description": "Login request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/login.Request"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully logged in",
                        "schema": {
                            "$ref": "#/definitions/login.Response"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/users/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get currently logged-in user profile from JWT token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Get My Profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/me.Response"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/users/verify/firebase": {
            "post": {
                "description": "Verify the idToken received from Firebase on Frontend to activate the user account.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Verify Firebase Token and Activate User",
                "parameters": [
                    {
                        "description": "Firebase verification request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/verify_firebase.Request"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User activated successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid token or request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "end.Request": {
            "type": "object",
            "required": [
                "lat",
                "lon",
                "user_id"
            ],
            "properties": {
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "entity.BikeData": {
            "type": "object",
            "properties": {
                "battery": {
                    "type": "integer"
                },
                "bike_id": {
                    "type": "string"
                },
                "current_ride_id": {
                    "type": "string"
                },
                "hardware_id": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "last_heartbeat": {
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "entity.Ride": {
            "type": "object",
            "properties": {
                "bikeID": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "distanceKm": {
                    "type": "number",
                    "format": "float64"
                },
                "endLat": {
                    "type": "number",
                    "format": "float64"
                },
                "endLon": {
                    "type": "number",
                    "format": "float64"
                },
                "endTime": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "startLat": {
                    "type": "number",
                    "format": "float64"
                },
                "startLon": {
                    "type": "number",
                    "format": "float64"
                },
                "startTime": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "totalFare": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                },
                "userID": {
                    "type": "string"
                }
            }
        },
        "internal_app_usecase_bike_create.Request": {
            "type": "object",
            "required": [
                "bike_id",
                "hardware_id"
            ],
            "properties": {
                "bike_id": {
                    "type": "string"
                },
                "hardware_id": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                }
            }
        },
        "internal_app_usecase_user_create.Request": {
            "type": "object",
            "required": [
                "password",
                "phone_number",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "password123"
                },
                "phone_number": {
                    "type": "string",
                    "minLength": 10,
                    "example": "0812345678"
                },
                "username": {
                    "type": "string",
                    "minLength": 2,
                    "example": "somchai_jaidee"
                }
            }
        },
        "login.Request": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "example": "somchai_jaidee"
                }
            }
        },
        "login.Response": {
            "type": "object",
            "properties": {
                "role": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "me.Response": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "phone_number": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "start.Request": {
            "type": "object",
            "required": [
                "bike_id",
                "user_id"
            ],
            "properties": {
                "bike_id": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "verify_firebase.Request": {
            "type": "object",
            "required": [
                "id_token"
            ],
            "properties": {
                "id_token": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type 'Bearer ' followed by your JWT token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}