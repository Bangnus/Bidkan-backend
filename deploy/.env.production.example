# ==============================================================
# BidKan Production Environment Configuration (DigitalOcean Droplet)
# ==============================================================

# --- Domain & Host Configuration ---
DOMAIN_NAME=bidkan.com
APP_ENV=production
PORT=8080

# --- Database (PostgreSQL with PostGIS) ---
POSTGRES_USER=bidkan_prod_user
POSTGRES_PASSWORD=generate-a-strong-random-password-here-64char
POSTGRES_DB=bidkan_db

# --- Redis Cache ---
REDIS_PASSWORD=generate-a-strong-redis-password

# --- Security & Auth (CRITICAL: Must match across services) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-strong-random-hex-string-at-least-64-characters-here
CORS_ALLOWED_ORIGINS=https://bidkan.com,https://app.bidkan.com,https://admin.bidkan.com

# --- Google OAuth 2.0 (For Rider Sign-In) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Stripe Connect & Rider Wallet Top-up ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_ACCOUNT_TYPE=express
STRIPE_CONNECT_COUNTRY=TH
STRIPE_BACKOFFICE_URL=https://admin.bidkan.com
STRIPE_CLIENT_URL=https://app.bidkan.com
STRIPE_AUTO_PAYOUT_ENABLED=true
STRIPE_AUTO_PAYOUT_INTERVAL=24h

# --- Public API URLs for Next.js Build ---
NEXT_PUBLIC_API_URL=https://api.bidkan.com/api/v1
NEXT_PUBLIC_MQTT_WS_URL=wss://mqtt.bidkan.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Let's Encrypt SSL Notification Email ---
SSL_EMAIL=admin@bidkan.com
