# /opt/bidkan/.env.prod บน Droplet (chmod 600) — ห้าม commit ไฟล์จริง
# ค่าที่มี (บังคับ) ขาดไม่ได้: compose หยุดก่อนแตะ container ตัวเดิมรันต่อ
# รหัสทุกตัวสร้างด้วย: openssl rand -hex 32   (มีแค่ 0-9 a-f ใส่ใน URL ได้ไม่ต้อง escape)

# (บังคับ) ชื่อ GitHub เจ้าของ repo ตัวพิมพ์เล็ก — image อยู่ที่ ghcr.io/<ชื่อนี้>/bidkan-backend
GHCR_OWNER=bangnus

# (บังคับ) ฐานข้อมูล — ตั้งครั้งเดียวก่อน deploy แรก เปลี่ยนทีหลังต้องเปลี่ยนใน Postgres ด้วย
POSTGRES_PASSWORD=

# (บังคับ) อย่างน้อย 32 ตัวอักษร
JWT_SECRET=

# (บังคับ) โดเมน production ของหน้าเว็บบน Vercel (client, backoffice) คั่นด้วย , ไม่มี / ท้าย — แก้เป็นโดเมนจริง
CORS_ALLOWED_ORIGINS=https://bidkan-client.vercel.app,https://bidkan-backoffice.vercel.app

# (บังคับ) ใส่ค่าเดียวกันใน Vercel ทั้งสอง project (PROXY_SHARED_SECRET) — ให้ API เห็น IP จริงของผู้ใช้
PROXY_SHARED_SECRET=

# (บังคับ) MQTT: backend = API ใช้, device = ใส่ใน firmware (MQTT_USER "device" / MQTT_PASS)
MQTT_BACKEND_PASSWORD=
MQTT_DEVICE_PASSWORD=

# Google Sign-In ของผู้ขับขี่
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — ว่าง = ปิด
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_TYPE=express
STRIPE_CONNECT_COUNTRY=TH
STRIPE_BACKOFFICE_URL=https://bidkan-backoffice.vercel.app
STRIPE_CLIENT_URL=https://bidkan-client.vercel.app
STRIPE_AUTO_PAYOUT_ENABLED=false
STRIPE_AUTO_PAYOUT_INTERVAL=24h
